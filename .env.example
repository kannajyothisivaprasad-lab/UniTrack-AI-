# ==============================================================================
# UniTrack AI - Environment Configuration Example
# Copy this file to .env and customize for your environment
# ==============================================================================

# Application Security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_2026
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Database Configuration
# Default: Embedded SQLite (Zero external dependency, out-of-the-box Windows execution)
DATABASE_URL=sqlite:///unitrack.db

# Production Enterprise PostgreSQL Example:
# DATABASE_URL=postgresql://unitrack_user:SecurePass123@localhost:5432/unitrack_db

# Security & Cookie Settings
SESSION_COOKIE_SECURE=False  # Set to True in HTTPS production environments
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=8

# Machine Learning Engine Configuration
ML_MODEL_DIR=models
DATASET_PATH=data/student_performance_2500.csv
BENCHMARK_RANDOM_STATE=42
